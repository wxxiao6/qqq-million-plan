{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-finance-workbench",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "CLOUDFLARE_RUNTIME": "1", "SITE_AUTH_REQUIRED": "1" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-finance-db",
      "database_id": "95316818-41ce-4af3-9763-1ae9bf886172"
    }
  ]
}

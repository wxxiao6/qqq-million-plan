{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qqq-million-plan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "qqq-million-plan.cc.cd", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "vars": { "CLOUDFLARE_RUNTIME": "1", "SITE_AUTH_REQUIRED": "0" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-finance-db",
      "database_id": "95316818-41ce-4af3-9763-1ae9bf886172"
    }
  ]
}

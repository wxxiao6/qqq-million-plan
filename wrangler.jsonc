{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qqq-million-plan",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": { "crons": ["0 18 * * *", "*/15 10-15 * * *", "0 23 * * *", "0 17 * * SUN"] },
  "services": [{ "binding": "JOBS_SELF", "service": "qqq-million-plan" }],
  "routes": [{ "pattern": "qqq-million-plan.cc.cd", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "vars": {
    "CLOUDFLARE_RUNTIME": "1",
    "QUOTA_SOURCE_HOSTS": "pdf.dfcfw.com,www.sse.com.cn,www.gffunds.com.cn,gfwx.gffunds.com.cn"
  },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-finance-db",
      "database_id": "95316818-41ce-4af3-9763-1ae9bf886172"
    }
  ]
}
